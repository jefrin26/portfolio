---
import skills from "../data/skills.json";
import SectionHeader from "./SectionHeader.astro";

const icons: Record<string, string> = {
  router:
    "M8 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm8 6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-8 6a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM8 9v6m0-12a3 3 0 0 0 3 3h2a3 3 0 0 1 3 3v3m0 0a3 3 0 0 1-3 3h-2a3 3 0 0 0-3 3",
  shield:
    "M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6l-7-3Z",
  terminal:
    "m6 9 3 3-3 3m5 0h5M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z",
  cloud:
    "M6.5 20a4.5 4.5 0 0 1-.7-8.95A6.5 6.5 0 0 1 18.6 9.4 4 4 0 0 1 17.5 20h-11Z",
};
---

<section id="skills" class="section-anchor reveal relative py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeader label="skills" title={skills.title} />
    <p class="mt-4 max-w-2xl text-ink-900/60 dark:text-paper-50/60">
      {skills.sub}
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {skills.items.map((domain) => (
        <div
          class="panel group rounded-xl p-6 transition-all duration-300 hover:-translate-y-1 hover:border-rosso-500/50 hover:shadow-[0_0_40px_rgb(255,30,60/0.08)]"
        >
          <div class="flex items-center gap-3">
            <span
              class="flex h-10 w-10 items-center justify-center rounded-lg bg-rosso-500/10 text-rosso-600 dark:text-rosso-400"
            >
              <svg
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={icons[domain.icon]} />
              </svg>
            </span>
            <h3 class="font-mono text-base font-semibold">
              <span class="text-rosso-600 dark:text-rosso-400">[</span>
              {domain.label}
              <span class="text-rosso-600 dark:text-rosso-400">]</span>
            </h3>
          </div>
          <div class="mt-5 flex flex-wrap gap-2">
            {domain.items.map((item) => (
              <span
                class="rounded-md border border-ink-900/10 bg-white/50 px-3 py-1 font-mono text-xs text-ink-900/80 transition-colors group-hover:border-rosso-500/30 dark:border-navy-500/50 dark:bg-navy-900/50 dark:text-paper-50/80 dark:group-hover:border-rosso-500/40"
              >
                {item}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
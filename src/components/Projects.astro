---
import projects from "../data/projects.json";
import MiniTopology from "./MiniTopology.astro";
import SectionHeader from "./SectionHeader.astro";
---

<section id="projects" class="section-anchor reveal relative py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeader label="projects" title={projects.title} />
    <p class="mt-4 max-w-2xl text-ink-900/60 dark:text-paper-50/60">
      {projects.sub}
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        projects.items.map((project) => (
          <article class="panel group overflow-hidden rounded-xl transition-all duration-300 hover:-translate-y-1 hover:border-rosso-500/50 hover:shadow-[0_0_50px_rgb(255,30,60/0.1)]">
            <div class="flex items-center gap-2 border-b border-ink-900/10 bg-paper-100/60 px-4 py-2.5 dark:border-navy-600/40 dark:bg-navy-900/60">
              <span class="h-2.5 w-2.5 rounded-full bg-rosso-500" />
              <span class="h-2.5 w-2.5 rounded-full bg-led-amber" />
              <span class="h-2.5 w-2.5 rounded-full bg-led-green" />
              <span class="ml-2 truncate font-mono text-xs text-ink-900/60 dark:text-paper-50/60">
                jefrin@network:~$ {project.command}
              </span>
            </div>

            <div class="p-6">
              <h3 class="font-mono text-lg font-bold text-ink-950 transition-colors group-hover:text-rosso-600 dark:text-white dark:group-hover:text-rosso-400">
                {project.name}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-900/70 dark:text-paper-50/70">
                {project.summary}
              </p>

              <div class="mt-4 flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <span class="rounded-md border border-ink-900/10 bg-white/50 px-2.5 py-0.5 font-mono text-[11px] text-ink-900/80 dark:border-navy-500/50 dark:bg-navy-900/50 dark:text-paper-50/80">
                    {tag}
                  </span>
                ))}
              </div>

              <div class="mt-5 flex items-center gap-4 font-mono text-xs">
                <a
                  href={project.links.demo}
                  class="text-rosso-600 transition-colors hover:text-rosso-400 dark:text-rosso-400 dark:hover:text-rosso-300"
                >
                  demo ↗
                </a>
                <a
                  href={project.links.repo}
                  class="text-ink-900/60 transition-colors hover:text-rosso-600 dark:text-paper-50/60 dark:hover:text-rosso-400"
                >
                  repo ↗
                </a>
              </div>

              <div class="mt-5 rounded-lg border border-ink-900/10 bg-white/40 p-3 dark:border-navy-600/40 dark:bg-navy-900/40">
                <MiniTopology labels={project.topology} />
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

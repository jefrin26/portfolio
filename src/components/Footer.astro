---
import site from "../data/site.json";
---

<footer
  class="border-t border-ink-900/10 bg-paper-100/60 py-8 dark:border-navy-600/40 dark:bg-navy-900"
>
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-3 px-4 text-center font-mono text-xs text-ink-900/50 sm:px-6 dark:text-paper-50/50"
  >
    <p class="inline-flex items-center gap-2">
      <span class="led inline-block h-1.5 w-1.5 rounded-full bg-led-green"
      ></span>
      © <span data-year></span>
      {site.name} — all systems operational
    </p>
    <p>
      uptime {site.uptime} · {site.est} · built with
      <a
        href={site.footerBuiltWith.url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-rosso-600 transition-colors hover:text-rosso-400 dark:text-rosso-400"
        >{site.footerBuiltWith.text}</a
      >
    </p>
    <a
      href="#home"
      class="inline-flex items-center gap-1 text-ink-900/40 transition-colors hover:text-rosso-600 dark:text-paper-50/40 dark:hover:text-rosso-400"
    >
      <span aria-hidden="true">^</span> traceroute --home
    </a>
  </div>
</footer>

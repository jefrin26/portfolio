---
interface Props {
  label: string;
  title: string;
}

const { label, title } = Astro.props;
---

<div>
  <p class="font-mono text-sm font-semibold text-rosso-600 dark:text-rosso-400">
    <span class="text-paper-300 dark:text-navy-500">//</span> {label}
  </p>
  <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink-950 sm:text-4xl dark:text-white">
    {title}
  </h2>
</div>
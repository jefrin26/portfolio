---
import { site } from "../data/site";
import SectionHeader from "./SectionHeader.astro";

const links = [
  { label: "mail", value: site.email, href: `mailto:${site.email}`, led: "bg-led-green" },
  { label: "github", value: site.github.replace("https://", ""), href: site.github, led: "bg-led-green" },
  { label: "linkedin", value: site.linkedin.replace("https://", ""), href: site.linkedin, led: "bg-led-green" },
  { label: "location", value: site.location, href: undefined, led: "bg-led-green" },
] as const;
---

<section id="contact" class="section-anchor relative py-24">
  <div
    class="pointer-events-none absolute bottom-0 left-1/2 h-[420px] w-[720px] -translate-x-1/2 rounded-full bg-rosso-500/10 blur-[140px] dark:bg-rosso-600/15"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-4xl px-4 sm:px-6">
    <div class="text-center">
      <SectionHeader label="contact" title="Open a session" />
      <p class="mx-auto mt-4 max-w-xl text-ink-900/60 dark:text-paper-50/60">
        Hiring for a network role, or want to talk routing tables and racing? My
        inbox is up and reachable.
      </p>
      <a
        href={`mailto:${site.email}`}
        class="glow-rosso mt-8 inline-flex items-center gap-2 rounded-md bg-rosso-500 px-8 py-3.5 font-semibold text-white transition-transform hover:-translate-y-0.5 hover:bg-rosso-400"
      >
        <span class="font-mono text-sm">❯</span> get in touch
      </a>
    </div>

    <div class="panel mt-12 overflow-hidden rounded-xl font-mono text-sm">
      <div class="flex items-center gap-2 border-b border-ink-900/10 bg-paper-100/60 px-4 py-2.5 dark:border-navy-600/40 dark:bg-navy-900/60">
        <span class="h-2.5 w-2.5 rounded-full bg-rosso-500"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-led-amber"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-led-green"></span>
        <span class="ml-2 text-xs text-ink-900/50 dark:text-paper-50/50">
          jefrin@network: show links
        </span>
      </div>
      <ul class="divide-y divide-ink-900/10 dark:divide-navy-600/40">
        {links.map((link) => (
          <li>
            {link.href ? (
              <a
                href={link.href}
                target={link.href.startsWith("mailto") ? undefined : "_blank"}
                rel="noopener noreferrer"
                class="group flex items-center gap-4 px-5 py-4 transition-colors hover:bg-rosso-500/5"
              >
                <span class={`led inline-block h-2 w-2 shrink-0 rounded-full ${link.led}`}></span>
                <span class="w-24 shrink-0 text-ink-900/50 dark:text-paper-50/50">
                  {link.label} →
                </span>
                <span class="truncate text-ink-900 transition-colors group-hover:text-rosso-600 dark:text-paper-50 dark:group-hover:text-rosso-400">
                  {link.value}
                </span>
              </a>
            ) : (
              <div class="flex items-center gap-4 px-5 py-4">
                <span class={`led inline-block h-2 w-2 shrink-0 rounded-full ${link.led}`}></span>
                <span class="w-24 shrink-0 text-ink-900/50 dark:text-paper-50/50">
                  {link.label} →
                </span>
                <span class="truncate text-ink-900 dark:text-paper-50">{link.value}</span>
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
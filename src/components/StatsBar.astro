---
import site from "../data/site.json";

const { stats } = site;
---

<section class="relative border-y border-ink-900/10 bg-paper-100/60 dark:border-navy-600/40 dark:bg-navy-900">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <p class="font-mono text-xs text-ink-900/50 dark:text-paper-50/50">
      <span class="text-rosso-500">❯</span> show interfaces statistics
    </p>
    <dl class="mt-6 grid grid-cols-2 gap-6 lg:grid-cols-4">
      {stats.map((s) => (
        <div class="group">
          <dt class="font-mono text-[11px] text-ink-900/50 dark:text-paper-50/50">
            <span class="text-led-green">●</span> {s.label}:
          </dt>
          <dd class="mt-1 font-mono text-3xl font-bold tracking-tight text-ink-950 group-hover:text-rosso-600 sm:text-4xl dark:text-white dark:group-hover:text-rosso-400">
            {s.value}
            <span class="text-base font-medium text-ink-900/40 dark:text-paper-50/40">
              {s.unit}
            </span>
          </dd>
        </div>
      ))}
    </dl>
    <p class="mt-6 font-mono text-[11px] text-ink-900/40 dark:text-paper-50/40">
      {site.uptime} uptime · {site.est} · last_updated: <span data-year></span>
    </p>
  </div>
</section>
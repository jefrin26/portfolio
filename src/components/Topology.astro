<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 640 560"
  class="h-auto w-full drop-shadow-2xl"
  role="img"
  aria-label="Network topology diagram"
>
  <g class="traffic-line topo-stroke" fill="none" stroke-width="2">
    <line x1="320" y1="80" x2="180" y2="150" />
    <line x1="320" y1="80" x2="460" y2="150" />
    <line x1="180" y1="150" x2="320" y2="250" />
    <line x1="460" y1="150" x2="320" y2="250" />
    <line x1="320" y1="270" x2="320" y2="370" />
    <line x1="320" y1="390" x2="140" y2="470" />
    <line x1="320" y1="390" x2="500" y2="470" />
  </g>
  <g class="topo-stroke" fill="none" stroke-width="1.5">
    <line x1="140" y1="490" x2="500" y2="490" stroke-dasharray="5 5" />
  </g>

  <g class="topo-text" font-family="JetBrains Mono, monospace" font-size="10" font-weight="600">
    <text x="250" y="112" text-anchor="end">10GE</text>
    <text x="390" y="112" text-anchor="start">10GE</text>
    <text x="250" y="262" text-anchor="end">10GE</text>
    <text x="390" y="262" text-anchor="start">10GE</text>
    <text x="334" y="320" text-anchor="start">1GE</text>
    <text x="236" y="432" text-anchor="end">1GE</text>
    <text x="404" y="432" text-anchor="start">1GE</text>
    <text x="320" y="516" text-anchor="middle">1GE · redundant link</text>
  </g>

  <g class="topo-cloud-fill topo-stroke" fill-opacity="0.9" stroke-width="2">
    <circle cx="280" cy="52" r="26" />
    <circle cx="320" cy="42" r="32" />
    <circle cx="360" cy="52" r="26" />
    <rect x="276" y="52" width="88" height="26" rx="13" />
  </g>
  <g class="topo-text" font-family="JetBrains Mono, monospace" font-size="11" font-weight="700">
    <text x="320" y="68" text-anchor="middle">ISP</text>
  </g>
  <circle class="led" cx="336" cy="62" r="3" fill="#22c55e" />

  <g class="topo-node-fill topo-stroke" stroke-width="1.5">
    <rect x="115" y="130" width="130" height="40" rx="10" />
    <rect x="395" y="130" width="130" height="40" rx="10" />
    <rect x="255" y="230" width="130" height="40" rx="10" />
    <rect x="255" y="350" width="130" height="40" rx="10" />
    <rect x="75" y="450" width="130" height="40" rx="10" />
    <rect x="435" y="450" width="130" height="40" rx="10" />
  </g>
  <g
    class="topo-text"
    font-family="JetBrains Mono, monospace"
    font-size="11"
    font-weight="700"
    text-anchor="middle"
  >
    <text x="180" y="154">EDGE-R1</text>
    <text x="460" y="154">EDGE-R2</text>
    <text x="320" y="254">CORE-R1</text>
    <text x="320" y="374">FW-1</text>
    <text x="140" y="474">DIST-SW1</text>
    <text x="500" y="474">DIST-SW2</text>
  </g>
  <g font-family="JetBrains Mono, monospace" font-size="8" font-weight="600" text-anchor="middle">
    <text class="topo-text" x="180" y="185" opacity="0.7">Gi0/0/0</text>
    <text class="topo-text" x="460" y="185" opacity="0.7">Gi0/0/0</text>
    <text class="topo-text" x="320" y="285" opacity="0.7">Ten0/0/1</text>
    <text class="topo-text" x="320" y="405" opacity="0.7">Ten0/0/0</text>
    <text class="topo-text" x="140" y="505" opacity="0.7">Gi1/0/24</text>
    <text class="topo-text" x="500" y="505" opacity="0.7">Gi1/0/24</text>
  </g>

  <circle class="led" cx="233" cy="142" r="4" fill="#22c55e" />
  <circle class="led" cx="513" cy="142" r="4" fill="#22c55e" />
  <circle class="led" cx="373" cy="242" r="4" fill="#22c55e" />
  <circle class="led" cx="373" cy="362" r="4" fill="#f59e0b" />
  <circle class="led" cx="193" cy="462" r="4" fill="#22c55e" />
  <circle class="led" cx="553" cy="462" r="4" fill="#22c55e" />

  <g fill="#ff1e3c">
    <circle r="4.5">
      <animateMotion dur="8s" repeatCount="indefinite" path="M320,80 L180,150 L320,250" />
    </circle>
    <circle r="4.5">
      <animateMotion dur="9s" repeatCount="indefinite" path="M320,80 L460,150 L320,250" />
    </circle>
    <circle r="4.5">
      <animateMotion dur="7s" repeatCount="indefinite" path="M320,270 L320,370 L140,470" />
    </circle>
    <circle r="4.5">
      <animateMotion dur="10s" repeatCount="indefinite" path="M320,270 L320,370 L500,470" />
    </circle>
  </g>
</svg>
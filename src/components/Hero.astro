---
import site from "../data/site.json";
import Topology from "./Topology.astro";
---

<section id="home" class="relative overflow-hidden">
  <div class="bg-grid absolute inset-0" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute -top-32 right-0 h-[560px] w-[560px] rounded-full bg-rosso-500/20 blur-[140px] dark:bg-rosso-600/25"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative mx-auto grid min-h-screen max-w-6xl items-center gap-10 px-4 pt-28 pb-16 sm:px-6 lg:grid-cols-[1.05fr_1fr] lg:pt-24"
  >
    <div>
      <div class="mb-6 flex flex-wrap gap-2 font-mono text-[11px]">
        <span
          class="inline-flex items-center gap-1.5 rounded-full border border-led-green/40 bg-led-green/10 px-3 py-1 text-led-green"
        >
          <span class="led inline-block h-1.5 w-1.5 rounded-full bg-led-green"
          ></span>
          {site.badges[0]}
        </span>
        <span
          class="inline-flex items-center gap-1.5 rounded-full border border-led-amber/40 bg-led-amber/10 px-3 py-1 text-led-amber"
        >
          <span class="led inline-block h-1.5 w-1.5 rounded-full bg-led-amber"
          ></span>
          {site.badges[1]}
        </span>
      </div>

      <p class="font-mono text-sm text-ink-900/60 dark:text-paper-50/60">
        <span class="text-led-green">{site.handle}@network</span><span
          class="text-paper-300 dark:text-navy-500">:</span
        ><span class="text-navy-400 dark:text-sky-300">~</span><span
          class="text-paper-300 dark:text-navy-500">$</span
        >
        whoami<span class="caret"></span>
      </p>

      <h1
        class="mt-2 text-6xl font-extrabold tracking-tight text-ink-950 sm:text-7xl lg:text-8xl dark:text-white"
      >
        {site.name}
      </h1>

      <p
        class="mt-3 font-mono text-base text-rosso-600 sm:text-lg dark:text-rosso-400"
      >
        → {site.role}
        <span class="text-ink-900/50 dark:text-paper-50/50"
          >· {site.ccnaStatus}</span
        >
      </p>

      <p
        class="mt-6 max-w-xl text-lg leading-relaxed text-ink-900/70 dark:text-paper-50/70"
      >
        {site.tagline}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="#projects"
          class="glow-rosso inline-flex items-center gap-2 rounded-md bg-rosso-500 px-6 py-3 font-semibold text-white transition-transform hover:-translate-y-0.5 hover:bg-rosso-400"
        >
          View Projects
          <span aria-hidden="true">↓</span>
        </a>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 rounded-md border border-ink-900/20 px-6 py-3 font-mono text-sm font-medium text-ink-900 transition-colors hover:border-rosso-500/60 hover:text-rosso-600 dark:border-navy-500/60 dark:text-paper-50 dark:hover:border-rosso-500/60 dark:hover:text-rosso-400"
        >
          ping --contact
        </a>
      </div>

      <div
        class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 font-mono text-xs text-ink-900/60 dark:text-paper-50/60"
      >
        <a
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 transition-colors hover:text-rosso-500 dark:hover:text-rosso-400"
        >
          <svg
            class="h-4 w-4"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49v-1.7c-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.94.85.09-.66.35-1.12.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9v2.82c0 .27.18.6.69.49A10.23 10.23 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"
            ></path>
          </svg>
          github
        </a>
        <a
          href={site.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 transition-colors hover:text-rosso-500 dark:hover:text-rosso-400"
        >
          <svg
            class="h-4 w-4"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z"
            ></path>
          </svg>
          linkedin
        </a>
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center gap-2 transition-colors hover:text-rosso-500 dark:hover:text-rosso-400"
        >
          <svg
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
            ></path>
          </svg>
          email
        </a>
        <span class="hidden h-4 w-px bg-ink-900/15 sm:block dark:bg-paper-50/15"
        ></span>
        <span class="inline-flex items-center gap-1.5">
          <span class="led inline-block h-1.5 w-1.5 rounded-full bg-led-green"
          ></span>
          {site.availability}
        </span>
      </div>
    </div>

    <div class="animate-float-slow mx-auto w-full max-w-[620px]">
      <Topology />
    </div>
  </div>
</section>
